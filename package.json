{
  "name": "tripai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:intake": "tsx --test --test-concurrency=1 tests/intake/**/*.test.ts",
    "test:retrieval": "tsx --test --test-concurrency=1 tests/retrieval/**/*.test.ts",
    "test:generation": "tsx --test --test-concurrency=1 tests/generation/**/*.test.ts",
    "test:plan-review": "tsx --test --test-concurrency=1 tests/plan-review/**/*.test.ts",
    "test:checkout": "tsx --test --test-concurrency=1 tests/checkout/**/*.test.ts",
    "test:trip-detail": "tsx --test --test-concurrency=1 tests/trip-detail/**/*.test.ts",
    "test:scrapbook": "tsx --test --test-concurrency=1 tests/scrapbook/**/*.test.ts",
    "test:revisions": "tsx --test --test-concurrency=1 tests/revisions/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:auth": "tsx --test --test-concurrency=1 tests/auth/**/*.test.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/db/**/*.test.ts"
  },
  "dependencies": {
    "@neondatabase/auth": "^0.4.2-beta",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.9",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
