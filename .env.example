# TripAI environment template.
# Copy to `.env.local` for local development. Do not commit real secrets.

# Phase 0 / F1-F3: Neon Postgres + Neon Auth
DATABASE_URL=
# F2 tests must point to a Neon testing branch, not the default branch.
DATABASE_TEST_URL=
NEON_API_KEY=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Phase 1 / F5-F6: live itinerary grounding and AI generation
GOOGLE_MAPS_API_KEY=
OPENROUTER_API_KEY=

# Phase 2 / F8: checkout. Disabled by default; enable deliberately per environment.
TRIPAI_STRIPE_ENABLED=0
TRIPAI_APP_BASE_URL=
TRIPAI_TRIP_PRICE_CENTS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Phase 2 / F10: scrapbook. Disabled by default; enable deliberately per environment.
TRIPAI_SCRAPBOOK_ENABLED=0

# Phase 3 / F11: post-purchase and mid-trip revisions use existing database,
# auth, retrieval, generation, and scrapbook settings. No new environment
# variable is required for the first revision-control slice.

# Phase 2+ photos: object storage is still deferred after F10 notes/ratings.
# STORAGE_ENDPOINT=
# STORAGE_REGION=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
